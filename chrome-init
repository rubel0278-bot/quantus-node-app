#!/usr/bin/env bash
# Quantus Node — StratumOS Chrome Init
# Called by StratumOS to set up Chrome browser integration

set -euo pipefail

INSTALL_DIR="/opt/quantus-node"

# Create a simple HTML redirect for Chrome
mkdir -p "${INSTALL_DIR}/www/chrome"
cat > "${INSTALL_DIR}/www/chrome/index.html" << 'EOF'
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="refresh" content="0; url=https://telemetry.quantus.cat/">
    <title>Quantus Telemetry</title>
</head>
<body>
    <p>Redirecting to <a href="https://telemetry.quantus.cat/">Quantus Telemetry</a>...</p>
</body>
</html>
EOF

echo "[quantus-node] Chrome init complete"
