#!/usr/bin/env bash
# Quantus Node — StratumOS Menu Init
# Called by StratumOS to add the app to the system menu

set -euo pipefail

INSTALL_DIR="/opt/quantus-node"

# Create menu entry
mkdir -p /usr/share/applications

cat > /usr/share/applications/quantus-node-dashboard.desktop << EOF
[Desktop Entry]
Version=1.0
Name=Quantus Node Dashboard
Comment=Quantus Network Node Management
Exec=xdg-open http://localhost:8080
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=Network;Finance;
EOF

echo "[quantus-node] Menu init complete"
