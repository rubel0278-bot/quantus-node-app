[Unit]
Description=Quantus Network Node
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/quantus-node
Environment="RUST_LOG=info"
ExecStart=/opt/quantus-node/bin/quantus-node \
    --name "stratum-node" \
    --validator \
    --chain mainnet \
    --base-path /opt/quantus-node/data \
    --node-key-file /opt/quantus-node/data/node_key.p2p \
    --rewards-inner-hash PLACEHOLDER \
    --miner-listen-port 9833 \
    --port 30333 \
    --rpc-port 9944 \
    --prometheus-port 9615 \
    --sync full \
    --max-blocks-per-request 64 \
    --rpc-methods safe
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/quantus-node/logs/quantus-node.log
StandardError=append:/opt/quantus-node/logs/quantus-node.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/quantus-node/data /opt/quantus-node/logs

[Install]
WantedBy=multi-user.target
