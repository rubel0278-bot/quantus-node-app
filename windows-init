#!/usr/bin/env bash
# Quantus Node — StratumOS Windows Init
# Called by StratumOS to initialize the desktop environment for the app
# StratumOS uses Openbox as its window manager

set -euo pipefail

INSTALL_DIR="/opt/quantus-node"

# Create desktop entry
mkdir -p /usr/share/applications
cat > /usr/share/applications/quantus-node.desktop << EOF
[Desktop Entry]
Version=1.0
Name=Quantus Node
Comment=Quantus Network Mining Node
Exec=xterm -title "Quantus Node" -e "${INSTALL_DIR}/update --status"
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=Network;Finance;
Keywords=quantus;blockchain;mining;node;
EOF

echo "[quantus-node] Desktop integration complete"
